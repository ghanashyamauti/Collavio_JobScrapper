# Cloud PostgreSQL (Supabase or Neon — paste your connection string here)
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@<YOUR_NEON_OR_SUPABASE_URL>:5432/DBNAME?sslmode=require
# Keeps local dev/tests working automatically until you paste your Supabase/Neon URL above
FALLBACK_SQLITE_FOR_LOCAL_DEV=true

# CORS
FRONTEND_ORIGIN=http://localhost:5173

# Built-in Scheduler Interval (hours - auto runs every 1 hour)
SYNC_INTERVAL_HOURS=1

# Dynamic Collector: JobSpy (LinkedIn, Naukri, Indeed, Glassdoor)
# Note: You can pass ANY custom role or location dynamically from the UI "Live Harvest" button or POST /api/sync.
# These env variables serve only as fallback defaults when no custom queries are provided.
JOBSPY_SITES=linkedin,naukri,indeed,glassdoor
SEARCH_QUERIES=Software Engineer,Product Manager
SEARCH_LOCATIONS=Bengaluru,Remote
COUNTRY_INDEED=India
RESULTS_PER_QUERY=10
HOURS_OLD=72
PROXIES=

# Collector 2: Direct Company ATS Slugs (Zero Auth - High India/Pune/Mumbai coverage)
GREENHOUSE_BOARDS=pubmatic,ensono,rubrik,zocdoc,druva,ivalua,inmobi,groww,stripe
LEVER_BOARDS=mindtickle,atlassian,plaid,spotify
ASHBY_BOARDS=linear,ramp,notion,vercel,openai,elevenlabs
SMARTRECRUITERS_BOARDS=visa,bosch,publicissapient,wipro
WORKABLE_BOARDS=

# Collector 3: Optional Higher Rate Limit for Himalayas (Works without key too)
HIMALAYAS_API_KEY=

# Collector 4: Optional Custom Career Page URLs (Schema.org JSON-LD extractor)
CAREER_URLS=

# Collector 5: Optional Free-Tier API Keys (Auto-activate when filled)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRIES=in,us,gb
JOOBLE_API_KEY=
RAPIDAPI_JSEARCH_KEY=
